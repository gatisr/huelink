# Settings for scripts/deploy.sh. Copy this file to .env (which is gitignored)
# and fill it in. Values are taken literally except for one optional layer of
# surrounding quotes, so there is no inline-comment syntax: keep comments on
# their own line.
#
# Precedence is: environment variable, then .env.deploy, then .env. The first of
# those that sets a key wins, so this file is the bottom layer: it describes
# your installation, and anything above it overrides one run. See
# .env.deploy.example. A key set in both files is reported by name when the
# script starts, so a deploy can never quietly go to the wrong machine.

# Base URL of your Home Assistant, for example http://homeassistant.local:8123
HA_URL=
# A long-lived access token, created at the bottom of your Home Assistant profile page.
HA_TOKEN=

# The external_extensions directory of your zigbee2mqtt installation; huelink.mjs and huelink-lib/ are copied in here.
Z2M_EXTENSIONS_DIR=
# The external_converters directory, where huelink-exposes.mjs goes. Empty means the external_converters
# directory next to Z2M_EXTENSIONS_DIR, which is where a stock installation keeps it.
Z2M_CONVERTERS_DIR=

# The command that gives zigbee2mqtt a brand new Node process, for example
# "docker restart zigbee2mqtt" or "sudo systemctl restart zigbee2mqtt" or an ssh line to the host that runs it.
# This is the only way changes under extension/huelink-lib ever take effect: zigbee2mqtt's own hot reload re-imports
# huelink.mjs alone, and every module it imports stays in the Node module cache until the process ends.
# Leave it empty if you have no way to restart it; deploy.sh then hot reloads and says plainly that huelink-lib/ is not live.
Z2M_RESTART_CMD=
# Seconds to wait for zigbee2mqtt to come back and report the new version after that command. Empty means 120.
Z2M_RESTART_WAIT=

# Hostname or IP of the MQTT broker that zigbee2mqtt is connected to.
MQTT_HOST=
# Broker port. Empty means 1883.
MQTT_PORT=
# Broker username. Empty means connect anonymously.
MQTT_USER=
# Broker password. Empty means connect anonymously.
MQTT_PASSWORD=
# zigbee2mqtt's base topic, the prefix its bridge topics live under. Empty means zigbee2mqtt.
Z2M_BASE_TOPIC=
# The last segment of huelink's own topic, which must match "name" in huelink.config.json. deploy.sh reads
# the retained state there to find out what the live extension really runs. Empty means huelink.
HUELINK_NAME=

# Seconds to wait for zigbee2mqtt to answer on MQTT. Empty means 20.
MQTT_TIMEOUT=
# Seconds to wait for a single Home Assistant HTTP call. Empty means 15.
HA_TIMEOUT=
