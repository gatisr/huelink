# An optional second settings file for scripts/deploy.sh. Copy it to .env.deploy
# (which is gitignored) when you want ONE run to go somewhere other than your
# usual installation: a spare zigbee2mqtt, a test broker, a Home Assistant you
# are not afraid of.
#
# Precedence is: environment variable, then .env.deploy, then .env. The first of
# those that sets a key wins, so a key put here overrides the same key in .env,
# and a key left out here falls through to .env untouched. Only write the keys
# you actually want to change; this file is not meant to be a full copy of .env.
#
# A key set in BOTH files is reported by name when the script starts, together
# with which file won. That warning is the point of this file existing: a deploy
# that quietly goes to the wrong machine looks exactly like a successful one.
#
# The format is the same as .env: KEY=VALUE, one optional layer of surrounding
# quotes, comments on their own line, no inline comments.

# The target zigbee2mqtt, when it is not the one in .env.
Z2M_EXTENSIONS_DIR=
Z2M_CONVERTERS_DIR=
Z2M_RESTART_CMD=

# The broker that target zigbee2mqtt is connected to.
MQTT_HOST=
MQTT_PORT=
MQTT_USER=
MQTT_PASSWORD=

# The Home Assistant that should get the version sensor for this run.
HA_URL=
HA_TOKEN=
