    {
      "id": "wakeup",
      "name": { "en": "Mood: Sunrise Alarm", "lv": "Noskaņa: Saullēkts" },
      "kind": "ramp",
      "params": {
        "palette": "wakeup",
        "durationSeconds": 900,
        "from": 0.22,
        "to": 1.0,
        "segmentSpread": 0.15,
        "curve": "smooth",
        "brightness": 1.0
      },
      "preview": { "seconds": 1000 },
      "proof": {
        "maxDimRunSeconds": 240,
        "why": "A 15-minute alarm ramp, measured dim for 196 s. Being dim at the start is the whole point - that is what makes it a wake-up and not a lamp. The floor is still lifted off zero (from 0.22 on a #3a0f06 ember), so the first minute is a weak ember glow rather than rounding to 0,0,0, and `visible in` still holds it to that."
      }
    },
